# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# LLM - Gemini via OpenAI-compatible API (recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternative: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro

# Alternative LLM provider
OPENAI_API_KEY=
LLM_PROVIDER=gemini

# Embeddings
EMBEDDING_MODEL=text-embedding-004
# For local fallback, this is ignored and local-hashed-tfidf-384 is used

# RAG Configuration
TOP_K=5
MIN_RETRIEVAL_SCORE=0.08
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CONTEXT_CHARS=9000
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# Vector Store
VECTOR_STORE=memory

# Logging
LOG_LEVEL=info
